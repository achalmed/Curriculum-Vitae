# .gitignore — repo Curriculum-Vitae (raíz: 09 trabajo); clases según NORMATIVA_ARCHIVOS §5

# =============================================================================
# LISTA BLANCA DE LA RAÍZ
# =============================================================================
# La raíz del repo es una carpeta de trabajo: se ignora todo lo que cuelga de
# ella y solo se re-incluye el CV y los archivos del repo. Las demás carpetas
# (repos propios y material de trabajo) quedan fuera de git a propósito: el
# remoto es público.
/*
!/.gitignore
!/.github/
!/CLAUDE.md
!/AGENTS.md
!/README.md
!/cv/

# =============================================================================
# SECRETOS Y ENTORNO (nunca en git)
# =============================================================================
# Variables de entorno y credenciales, por si alguna vez aparecen dentro de cv/.
.env
.env.*

# =============================================================================
# ARTEFACTOS DE CONSTRUCCIÓN (clase artefacto: los regenera el compilador)
# =============================================================================
# Auxiliares del núcleo de LaTeX.
*.aux
*.lof
*.log
*.lot
*.fls
*.out
*.toc
*.fmt
*.fot
*.cb
*.cb2
.*.lb
# Salidas intermedias (DVI, XDV, conversiones de imágenes).
*.dvi
*.xdv
*-converted-to.*
# Bibliografía (biblatex, biber, bibtex).
*.bbl
*.bbl-SAVE-ERROR
*.bcf
*.bcf-SAVE-ERROR
*.blg
*-blx.aux
*-blx.bib
*.run.xml
# Herramientas de compilación y sincronización con el editor.
*.fdb_latexmk
*.synctex
*.synctex(busy)
*.synctex.gz
*.synctex.gz(busy)
*.pdfsync
*.rubbercache
rubber.cache
latex.out/
# Paquetes concretos (algoritmos, beamer, índices, glosarios, minitoc, todonotes…).
*.alg
*.loa
*.thm
*.nav
*.snm
*.vrb
*.cut
*.spl
*.mf
*.mp
*.tfm
*.idx
*.ilg
*.ind
*.maf
*.mlf
*.mlt
*.mtc[0-9]*
*.nlg
*.nlo
*.nls
*.tdo
*.xcp
*.xdy
*.listing
# minted, pythontex, sympy y svg (cachés de paquetes que ejecutan código).
_minted*/
*.data.minted
*.pyg
svg-inkscape/
sympy-plots-for-*.tex/
pythontex-files-*/

# =============================================================================
# PRODUCTO (los PDF compilados): no se versionan, se publican como Release
# =============================================================================
# Salida del Makefile (cv/build/) y de flujos anteriores (cv/output/).
build/
output/
# PDF que deja la compilación directa dentro de cv/main/.
cv/main/*.pdf

# =============================================================================
# TEMPORAL Y LOCAL DE LA MÁQUINA
# =============================================================================
# Borradores locales: contienen documentos de terceros que no se publican.
drafts/
# Ajustes locales de asistentes y editores.
.claude/
.directory
# Restos de R y SPSS, y metadatos del lector de libros.
.Rhistory
*.sav
*.sdr/
